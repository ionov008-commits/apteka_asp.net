@page
@{
    ViewData["Title"] = "Регистрация успешна";
    // Извлекаем ID, который положили в OnPostAsync
    var newId = TempData["NewId"];
}

<div style="font-family: 'Segoe UI', sans-serif; max-width: 600px; margin: 100px auto; text-align: center; border: 1px solid #e0e0e0; padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); background: white;">

    <div style="color: #28a745; font-size: 60px; margin-bottom: 20px;">✔</div>
    <h2 style="color: #333; margin-bottom: 10px;">Регистрация завершена!</h2>
    <p style="color: #666; font-size: 18px;">Вы успешно зарегистрированы в системе.</p>

    <div style="background: #f8f9fa; border: 2px dashed #0d6efd; padding: 20px; margin: 30px 0; border-radius: 10px;">
        <p style="margin: 0; color: #555; font-size: 16px;">Ваш уникальный номер для входа (Login ID):</p>

        @if (newId != null)
        {
            <h1 style="margin: 10px 0; color: #0d6efd; font-size: 48px; font-weight: 800;">@newId</h1>
        }
        else
        {
            <h1 style="margin: 10px 0; color: #dc3545; font-size: 24px;">ID не найден</h1>
            <p style="font-size: 12px; color: #999;">Попробуйте войти с номером, указанным администратором, или повторите регистрацию.</p>
        }
    </div>

    <p style="color: #888; font-size: 14px; margin-bottom: 30px;">
        <strong>Внимание:</strong> Пожалуйста, запомните или запишите этот номер. <br>
        Он понадобится вам для каждой авторизации в аптеке.
    </p>

    <a href="/Account/Login" style="display: inline-block; background: #0d6efd; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-weight: 600; transition: background 0.2s;">
        Перейти ко входу
    </a>
</div>