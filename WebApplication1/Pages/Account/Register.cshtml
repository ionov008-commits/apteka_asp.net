@page
@model WebApplication1.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="registration-container">
    <h2 class="form-title">Регистрация в системе</h2>

    <form method="post" id="registrationForm">
        <div asp-validation-summary="All" class="validation-error-summary"></div>

        <input type="hidden" asp-for="Input.Latitude" id="latInput" />
        <input type="hidden" asp-for="Input.Longitude" id="lonInput" />

        <div class="form-section">
            <h4 class="section-subtitle">Данные аккаунта</h4>
            <div class="grid-2">
                <div class="form-group">
                    <label>Логин <span class="required">*</span></label>
                    <input asp-for="Input.Username" class="form-input" placeholder="ivan_ivanov" required />
                    <span asp-validation-for="Input.Username" class="error-text"></span>
                </div>
                <div class="form-group">
                    <label>Email <span class="required">*</span></label>
                    <input asp-for="Input.Email" type="email" class="form-input" placeholder="example@mail.ru" required />
                    <span asp-validation-for="Input.Email" class="error-text"></span>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Пароль <span class="required">*</span></label>
                    <input asp-for="Input.Password" type="password" class="form-input" placeholder="********" required />
                </div>
                <div class="form-group">
                    <label>Подтверждение <span class="required">*</span></label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-input" placeholder="********" required />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label style="font-weight:700;">Тип учетной записи:</label>
            <select asp-for="Input.Role" id="roleSelect" onchange="toggleFields()" class="form-input">
                <option value="customer">Покупатель (Поиск лекарств)</option>
                <option value="owner">Владелец аптеки (Управление складом)</option>
                <option value="pharmacist">Фармацевт (Обслуживание клиентов)</option>
            </select>
        </div>

        <hr class="divider">

        <div class="form-group" id="mapSection">
            <label class="label-with-hint">Укажите местоположение на карте <span class="required">*</span></label>
            <div id="map"></div>
            <p class="map-hint">Кликните по карте или перетащите маркер, чтобы адрес заполнился автоматически.</p>
        </div>

        <div id="customerFields">
            <div class="form-group">
                <label>ФИО <span class="required">*</span></label>
                <input asp-for="Input.FullName" class="form-input" placeholder="Иванов Иван Иванович" />
            </div>
            <div class="form-group">
                <label>Телефон <span class="required">*</span></label>
                <input asp-for="Input.Phone" id="customerPhone" class="form-input" placeholder="+375 (__) ___-__-__" />
            </div>

            <div class="address-box">
                <label>Ваш адрес (для доставки):</label>
                <div class="grid-address">
                    <input type="text" id="addressCity" placeholder="Город" class="form-input" oninput="syncFieldsToMap()" />
                    <input type="text" id="addressStreet" placeholder="Улица" class="form-input" oninput="syncFieldsToMap()" />
                    <input type="text" id="addressHouse" placeholder="Дом" class="form-input" oninput="syncFieldsToMap()" />
                </div>
                <input type="hidden" asp-for="Input.Address" id="fullAddressField" />
            </div>
        </div>

        <div id="ownerFields" style="display:none;">
            <div class="form-group">
                <label>Название аптеки <span class="required">*</span></label>
                <input asp-for="Input.PharmacyName" class="form-input" placeholder="Аптека №1" />
            </div>
            <div class="form-group">
                <label>ФИО Руководителя <span class="required">*</span></label>
                <input asp-for="Input.DirectorName" class="form-input" placeholder="Петров Петр Петрович" />
            </div>
            <div class="form-group">
                <label>Адрес аптеки <span class="required">*</span></label>
                <input asp-for="Input.PharmacyAddress" id="pharmacyAddrInput" class="form-input" placeholder="г. Минск, пр-т Независимости, 1" oninput="syncFieldsToMap()" />
            </div>
            <div class="form-group">
                <label>Рабочий телефон <span class="required">*</span></label>
                <input asp-for="Input.PharmacyPhone" id="ownerPhone" class="form-input" placeholder="+375 (17) ___-__-__" />
            </div>
        </div>

        <div id="pharmacistFields" style="display:none;">
            <div class="form-group">
                <label>ФИО Фармацевта <span class="required">*</span></label>
                <input asp-for="Input.PharmacistFullName" class="form-input" placeholder="Сидоров Сидор Сидорович" />
            </div>
            <div class="form-group">
                <label>Выберите аптеку <span class="required">*</span></label>
                <select asp-for="Input.PharmacyId" class="form-input" asp-items="Model.PharmacyOptions">
                    <option value="">-- Выберите аптеку из списка --</option>
                </select>
            </div>
            <div class="form-group">
                <label>Часы работы <span class="required">*</span></label>
                <input asp-for="Input.WorkingHours" class="form-input" placeholder="Пн-Пт: 08:00 - 17:00" />
            </div>
        </div>

        <div class="captcha-container">
            <div class="captcha-label">
                <span>Подтвердите, что вы человек:</span>
                <strong class="captcha-math">@ViewData["CaptchaText"]</strong>
            </div>
            <input asp-for="Input.CaptchaInput" type="number" class="captcha-input" placeholder="Ответ" required />
        </div>

        <button type="submit" class="submit-btn">Завершить регистрацию</button>
    </form>
</div>

<style>
    /* ... Твой CSS остается без изменений ... */
    .registration-container {
        max-width: 700px;
        margin: 40px auto;
        background: #fff;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 1px solid #eee;
    }

    .form-title {
        text-align: center;
        color: #2c3e50;
        margin-bottom: 25px;
        font-weight: 700;
    }

    .section-subtitle {
        color: #7f8c8d;
        border-bottom: 1px solid #eee;
        padding-bottom: 8px;
        margin-bottom: 15px;
        font-size: 16px;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            color: #34495e;
            font-size: 14px;
            font-weight: 600;
        }

    .form-input {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbd5e0;
        border-radius: 8px;
        font-size: 15px;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

        .form-input:focus {
            border-color: #3182ce;
            outline: none;
        }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .grid-address {
        display: grid;
        grid-template-columns: 1.5fr 2fr 0.7fr;
        gap: 10px;
    }

    .required {
        color: #e53e3e;
    }

    #map {
        width: 100%;
        height: 280px;
        border-radius: 8px;
        margin-bottom: 10px;
        border: 1px solid #cbd5e0;
        z-index: 1;
    }

    .map-hint {
        font-size: 12px;
        color: #718096;
        margin-bottom: 15px;
    }

    .address-box {
        background: #f7fafc;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #edf2f7;
    }

    .captcha-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ebf8ff;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #bee3f8;
        margin: 20px 0;
    }

    .captcha-math {
        font-size: 18px;
        color: #2b6cb0;
        margin-left: 10px;
    }

    .captcha-input {
        width: 100px;
        padding: 8px;
        border-radius: 6px;
        border: 1px solid #3182ce;
        text-align: center;
        font-size: 16px;
        font-weight: bold;
    }

    .submit-btn {
        width: 100%;
        padding: 16px;
        background: #3182ce;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

        .submit-btn:hover {
            background: #2b6cb0;
        }

    .validation-error-summary {
        color: #e53e3e;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .divider {
        border: 0;
        border-top: 1px solid #edf2f7;
        margin: 25px 0;
    }
</style>

<script>
    // --- ПЕРЕКЛЮЧЕНИЕ РОЛЕЙ ---
    function toggleFields() {
        const role = document.getElementById('roleSelect').value;

        document.getElementById('customerFields').style.display = (role === 'customer') ? 'block' : 'none';
        document.getElementById('ownerFields').style.display = (role === 'owner') ? 'block' : 'none';
        document.getElementById('pharmacistFields').style.display = (role === 'pharmacist') ? 'block' : 'none';

        // Фармацевту карта не нужна - скрываем её
        const mapSection = document.getElementById('mapSection');
        if (role === 'pharmacist') {
            mapSection.style.display = 'none';
        } else {
            mapSection.style.display = 'block';
            setTimeout(() => map.invalidateSize(), 100); // Поправляем размер Leaflet
        }
    }

    // --- МАСКА ТЕЛЕФОНА ---
    function applyPhoneMask(inputId) {
        const input = document.getElementById(inputId);
        if(!input) return;
        input.addEventListener('input', function (e) {
            let x = e.target.value.replace(/\D/g, '');
            if (x.startsWith('375')) x = x.substring(3);
            let res = '+375';
            if (x.length > 0) res += ' (' + x.substring(0, 2);
            if (x.length >= 3) res += ') ' + x.substring(2, 5);
            if (x.length >= 6) res += '-' + x.substring(5, 7);
            if (x.length >= 8) res += '-' + x.substring(7, 9);
            e.target.value = res;
        });
    }
    applyPhoneMask('customerPhone');
    applyPhoneMask('ownerPhone');

    // --- КАРТА И ГЕОКОДИРОВАНИЕ ---
    let map, marker;
    const latInput = document.getElementById('latInput');
    const lonInput = document.getElementById('lonInput');

    function initMap() {
        const defaultPos = [53.90, 27.56]; // Минск
        map = L.map('map').setView(defaultPos, 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        marker = L.marker(defaultPos, { draggable: true }).addTo(map);

        // Установка начальных координат
        latInput.value = defaultPos[0];
        lonInput.value = defaultPos[1];

        map.on('click', (e) => {
            marker.setLatLng(e.latlng);
            updateCoords(e.latlng.lat, e.latlng.lng);
            updateAddrFromCoords(e.latlng.lat, e.latlng.lng);
        });

        marker.on('dragend', () => {
            const p = marker.getLatLng();
            updateCoords(p.lat, p.lng);
            updateAddrFromCoords(p.lat, p.lng);
        });
    }

    function updateCoords(lat, lng) {
        latInput.value = lat.toFixed(6);
        lonInput.value = lng.toFixed(6);
    }

    async function updateAddrFromCoords(lat, lng) {
        try {
            const r = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&accept-language=ru`);
            const d = await r.json();
            if (d.address) {
                const a = d.address;
                const city = a.city || a.town || a.village || "Минск";
                const street = a.road || "";
                const house = a.house_number || "";

                if (document.getElementById('roleSelect').value === 'customer') {
                    document.getElementById('addressCity').value = city;
                    document.getElementById('addressStreet').value = street;
                    document.getElementById('addressHouse').value = house;
                } else if (document.getElementById('roleSelect').value === 'owner') {
                    document.getElementById('pharmacyAddrInput').value = `г. ${city}, ул. ${street}, д. ${house}`;
                }
            }
        } catch(e) { console.error("Ошибка геокодирования", e); }
    }

    let geocodeTimeout;
    function syncFieldsToMap() {
        clearTimeout(geocodeTimeout);
        geocodeTimeout = setTimeout(async () => {
            let addr = "";
            const role = document.getElementById('roleSelect').value;
            if (role === 'customer') {
                const city = document.getElementById('addressCity').value;
                const street = document.getElementById('addressStreet').value;
                const house = document.getElementById('addressHouse').value;
                addr = `${city} ${street} ${house}`;
            } else if (role === 'owner') {
                addr = document.getElementById('pharmacyAddrInput').value;
            }

            if (addr.length < 5) return;

            try {
                const r = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(addr)}`);
                const d = await r.json();
                if (d && d.length > 0) {
                    const newPos = [d[0].lat, d[0].lon];
                    marker.setLatLng(newPos);
                    map.panTo(newPos);
                    updateCoords(d[0].lat, d[0].lon);
                }
            } catch(e) {}
        }, 1200);
    }

    document.addEventListener("DOMContentLoaded", initMap);

    // Сборка полного адреса перед отправкой
    document.getElementById('registrationForm').addEventListener('submit', function () {
        if (document.getElementById('roleSelect').value === 'customer') {
            const city = document.getElementById('addressCity').value.trim();
            const street = document.getElementById('addressStreet').value.trim();
            const house = document.getElementById('addressHouse').value.trim();
            if (city && street && house) {
                document.getElementById('fullAddressField').value = `г. ${city}, ул. ${street}, д. ${house}`;
            }
        }
    });
</script>